# Copie ce fichier en bot/.env et remplis ce que tu utilises (tout est facultatif).

# Telegram : crée un bot avec @BotFather, puis récupère ton chat_id avec @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Discord : Paramètres du salon → Intégrations → Webhooks → Copier l'URL
DISCORD_WEBHOOK=

# Couplage avec les tâches planifiées : jeton GitHub « fine-grained »
# limité au dépôt Mon-projet-, permission « Contents : Read and write ».
GITHUB_TOKEN=
GITHUB_REPO=boudeygabriel-commits/Mon-projet-
GITHUB_BRANCHE=bot-alertes
